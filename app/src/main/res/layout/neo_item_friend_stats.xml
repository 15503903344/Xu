<?xml version="1.0" encoding="utf-8"?>
<!-- 好友统计单行条目：圆形头像 + 昵称/统计文本 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/neu_card_raised"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <com.surexu.sesame.ui.neo.NeoAsyncAvatarView
        android:id="@+id/neo_friend_stats_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_neo_profile"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/neo_friend_stats_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/neo_text_primary"
        android:textSize="14sp" />
</LinearLayout>
