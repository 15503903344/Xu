<?xml version="1.0" encoding="utf-8"?>
<!-- 日志页：分类标签 + 日志内容空态（对应新版截图：调试后有运行标签） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- 头部：居中标题 + 右上角图标（搜索/刷新/更多） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="日志"
                android:textColor="@color/neo_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/neo_logs_search_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_neo_search" />

                <ImageView
                    android:id="@+id/neo_logs_refresh_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_neo_refresh" />

                <ImageView
                    android:id="@+id/neo_logs_more_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_neo_more" />
            </LinearLayout>
        </FrameLayout>

        <!-- 搜索输入栏（点击放大镜后显示，输入实时过滤当前分类日志） -->
        <LinearLayout
            android:id="@+id/neo_logs_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/neu_input_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_search"
                android:tint="@color/neo_text_hint" />

            <EditText
                android:id="@+id/neo_logs_search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索当前分类日志"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/neo_text_primary"
                android:textColorHint="@color/neo_text_hint"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/neo_logs_search_close"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_back"
                android:tint="@color/neo_text_hint" />
        </LinearLayout>

        <!-- 分类标签栏（横向滑动：森林/庄园/其他/记录/错误/调试/运行） -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/neo_logs_tab_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 日志内容空态卡（白底水印） -->
        <LinearLayout
            android:id="@+id/neo_logs_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/neu_card_raised"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志"
                android:textColor="@color/neo_primary_soft"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="暂无日志"
                android:textColor="@color/neo_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="切换分类或执行对应操作后在此实时展示"
                android:textColor="@color/neo_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 日志条目列表容器（每条为拟态卡片，由 Kotlin 填充） -->
        <LinearLayout
            android:id="@+id/neo_logs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
