<?xml version="1.0" encoding="utf-8"?>
<!-- 单个配置字段条目：名称 + 值摘要 + 状态/箭头 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/neo_field_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/neu_card_raised"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/neo_field_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/neo_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/neo_field_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/neo_text_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/neo_field_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/neu_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/neo_text_hint"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/neo_field_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/neo_text_hint"
        android:textSize="22sp" />
</LinearLayout>
