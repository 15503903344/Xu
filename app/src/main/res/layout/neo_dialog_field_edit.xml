<?xml version="1.0" encoding="utf-8"?>
<!-- 配置编辑弹窗：标题 + 内容区 + 取消/确定 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/neu_card_raised"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/neo_edit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/neo_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/neo_edit_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/neo_edit_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="取消"
            android:textColor="@color/neo_text_hint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/neo_edit_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="确定"
            android:textColor="@color/neo_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
