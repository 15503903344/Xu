<?xml version="1.0" encoding="utf-8"?>
<!-- 原创拟态主界面：内容区 + 底部导航栏（首页/功能/日志/设置） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_base"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.neo.NeoMainActivity">

    <!-- 页面内容区（Kotlin 填充 4 个页面布局并切换可见性） -->
    <FrameLayout
        android:id="@+id/neo_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部拟态导航栏（id 供「悬浮底栏」样式切换：悬浮时改背景+边距为胶囊） -->
    <LinearLayout
        android:id="@+id/neo_nav_bar_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/neo_nav_home"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/neu_nav_item"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/neo_nav_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_home" />

            <TextView
                android:id="@+id/neo_nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="首页"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/neo_nav_features"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/neu_nav_item"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/neo_nav_features_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_features" />

            <TextView
                android:id="@+id/neo_nav_features_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="功能"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/neo_nav_logs"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/neu_nav_item"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/neo_nav_logs_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_logs" />

            <TextView
                android:id="@+id/neo_nav_logs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="日志"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/neo_nav_settings"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/neu_nav_item"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/neo_nav_settings_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_settings" />

            <TextView
                android:id="@+id/neo_nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="设置"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
