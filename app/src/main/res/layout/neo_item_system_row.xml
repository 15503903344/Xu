<?xml version="1.0" encoding="utf-8"?>
<!-- 系统界面单行条目：标题 + 副标题 + 右侧控件（开关 / 箭头） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/neu_card_raised"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/neo_system_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/neo_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/neo_system_row_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/neo_text_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/neo_system_row_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="›"
            android:textColor="@color/neo_primary"
            android:textSize="24sp"
            android:visibility="gone" />

        <Switch
            android:id="@+id/neo_system_row_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:thumbTint="@color/neo_primary"
            android:trackTint="@color/neo_primary_soft"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
