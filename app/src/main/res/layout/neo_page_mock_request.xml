<?xml version="1.0" encoding="utf-8"?>
<!-- 模拟请求独立页：顶栏返回 + 方法/数据输入 + 发送按钮 + 结果展示区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_base"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶栏：返回按钮 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/neo_mock_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/neu_logo_slot"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_back" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            android:text="模拟请求"
            android:textColor="@color/neo_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <EditText
                android:id="@+id/neo_mock_api_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/neu_input_bg"
                android:hint="方法（接口 api），如 com.alipay.antfarm.doFarmTask"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/neo_text_primary"
                android:textColorHint="@color/neo_text_hint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/neo_mock_data_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/neu_input_bg"
                android:gravity="top|start"
                android:hint="数据（请求参数 JSON），如 [{&quot;bizKey&quot;:&quot;...&quot;}]"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/neo_text_primary"
                android:textColorHint="@color/neo_text_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/neo_mock_send_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/neu_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="发送请求"
                android:textColor="@color/neo_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="结果"
                android:textColor="@color/neo_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/neo_mock_result_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/neu_input_bg"
                android:padding="12dp"
                android:text="等待发送请求…"
                android:textColor="@color/neo_text_primary"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
