<?xml version="1.0" encoding="utf-8"?>
<!-- 日志条目卡片：轻量凸起（单层浅影 + 高光描边），避免大量条目时阴影叠加卡顿 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="3dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_card" />
            <corners android:radius="19dp" />
            <stroke
                android:width="1dp"
                android:color="@color/neo_highlight" />
        </shape>
    </item>
</layer-list>
