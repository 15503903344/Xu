<?xml version="1.0" encoding="utf-8"?>
<!-- 原创拟态·凸起主按钮：霓虹青胶囊 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="3dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_shadow" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_primary" />
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="@color/neo_highlight" />
        </shape>
    </item>
</layer-list>
